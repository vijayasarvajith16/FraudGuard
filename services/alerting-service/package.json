{
  "name": "alerting-service",
  "version": "1.0.0",
  "description": "FraudGuard alerting: maps scored risk tiers to mitigations (notify, OTP step-up, block and freeze, manual review)",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --testPathIgnorePatterns /integration/",
    "test:coverage": "jest --coverage --testPathIgnorePatterns /integration/",
    "test:integration": "jest --testPathPatterns integration",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "../../.cache/mongodb-binaries"
    }
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "amqplib": "^2.2.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}
