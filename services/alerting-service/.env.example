# alerting-service configuration (docs/contracts.md §6.2, §7, §10). Copy to .env to run outside Docker.
NODE_ENV=development
PORT=3003
LOG_LEVEL=info
TRUST_PROXY=0

MONGO_URI=mongodb://alerting_service:change-me@localhost:27017/fraudguard_alerts?authSource=fraudguard_alerts&directConnection=true
MONGO_DB=fraudguard_alerts

# Consumes transactions.scored (docs/contracts.md §3.5).
RABBITMQ_URL=amqp://fraudguard:change-me@localhost:5672
CONSUMER_ENABLED=true
PREFETCH=10
MAX_RETRIES=3

# Shared secrets, at least 32 characters.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
TRANSACTION_SERVICE_URL=http://localhost:3002
TRANSACTION_SERVICE_TIMEOUT_MS=3000

# Tier -> action policy. Reloaded when its content changes (polling) or via POST /alerts/admin/config/reload.
TIER_ACTIONS_PATH=./src/config/tierActions.json
TIER_ACTIONS_POLL_SECONDS=30

# OTP step-up. OTP_SECRET keys both the code derivation and the stored hash (at least 32 characters).
OTP_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_SWEEP_INTERVAL_SECONDS=60
# Demo only: include the simulated OTP in the user's alert. Never enable in a shared environment.
EXPOSE_SIMULATED_OTP=false
