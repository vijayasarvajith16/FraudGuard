# transaction-service configuration (docs/contracts.md §2, §3, §10). Copy to .env to run outside Docker.
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
TRUST_PROXY=0

# MongoDB must be a replica set (multi-document transactions). From the host, add directConnection=true.
MONGO_URI=mongodb://transaction_service:change-me@localhost:27017/fraudguard_transactions?authSource=fraudguard_transactions&directConnection=true
MONGO_DB=fraudguard_transactions
RABBITMQ_URL=amqp://fraudguard:change-me@localhost:5672

# Shared with auth-service (verify tokens) and alerting-service (internal routes). At least 32 characters.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

AUTH_SERVICE_URL=http://localhost:3001
QUICK_SCAN_URL=http://localhost:8001
# Fail toward review if quick-scan does not answer within this budget.
QUICK_SCAN_TIMEOUT_MS=300
AUTH_LOOKUP_TIMEOUT_MS=2000

OUTBOX_RELAY_INTERVAL_MS=5000
PENDING_RECOVERY_SECONDS=30
PUBLISH_CONFIRM_TIMEOUT_MS=5000
