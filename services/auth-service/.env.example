# auth-service configuration (docs/contracts.md §10). Copy to .env for running outside Docker.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of the service (1 behind the gateway).
TRUST_PROXY=0

MONGO_URI=mongodb://auth_service:change-me@localhost:27017/fraudguard_auth?authSource=fraudguard_auth
MONGO_DB=fraudguard_auth

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Shared secret for /internal/* routes, at least 32 characters.
INTERNAL_SERVICE_TOKEN=

# Optional: creates this admin account at startup if it does not exist (both or neither).
ADMIN_EMAIL=
ADMIN_PASSWORD=
