{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "FraudGuard authentication service: registration, login, JWT issuance",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "../../.cache/mongodb-binaries"
    }
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.11",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
