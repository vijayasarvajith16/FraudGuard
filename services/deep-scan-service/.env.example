# deep-scan-service configuration (docs/contracts.md §5, §4.1, §6.1, §10).
PORT=8002
LOG_LEVEL=INFO

# MLflow model registry. DagsHub allows anonymous reads of public repos; set the
# username/token only if the DagsHub repo is private.
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MODEL_URI=models:/fraudguard-deep-scan@production

# Tests / offline development only. Keep false in any real environment.
ALLOW_LOCAL_MODEL_FALLBACK=false
LOCAL_MODEL_PATH=

# Risk tiers on the fraud probability: LOW < MEDIUM_MIN <= MEDIUM < HIGH_MIN <= HIGH < CRITICAL_MIN <= CRITICAL
TIER_MEDIUM_MIN=0.30
TIER_HIGH_MIN=0.70
TIER_CRITICAL_MIN=0.90

# RabbitMQ consumer: transactions.flagged -> transactions.scored (docs/contracts.md §3.5).
CONSUMER_ENABLED=true
RABBITMQ_URL=amqp://fraudguard:change-me@localhost:5672
MAX_RETRIES=3
PREFETCH=10
