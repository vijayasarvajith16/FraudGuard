# quick-scan-service configuration (docs/contracts.md §4, §4.1, §10).
PORT=8001
LOG_LEVEL=INFO

# MLflow model registry. DagsHub allows anonymous reads of public repos; set the
# username/token only if the DagsHub repo is private.
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MODEL_URI=models:/fraudguard-quick-scan@production

# Tests / offline development only: load an MLflow model directory from disk
# if the registry is unavailable. Keep false in any real environment.
ALLOW_LOCAL_MODEL_FALLBACK=false
LOCAL_MODEL_PATH=

# Optional: override the threshold stored with the model (flag when score >= threshold).
QUICK_SCAN_THRESHOLD=
