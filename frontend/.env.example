# Build time (baked into the bundle by Vite). Default: same-origin /api through the gateway.
VITE_API_BASE_URL=/api

# Development only: where `npm run dev` proxies /api (the gateway's host port).
GATEWAY_URL=http://localhost:8080

# Runtime (container): extra CSP connect-src sources when the API is on another origin.
NGINX_CSP_CONNECT_SRC='self'
