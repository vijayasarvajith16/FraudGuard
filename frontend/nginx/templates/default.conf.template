# Rendered by the image entrypoint (envsubst, NGINX_* variables only) into
# /etc/nginx/conf.d/default.conf.

# Strict CSP: everything from this origin, API calls to 'self' unless NGINX_CSP_CONNECT_SRC adds
# the gateway's origin (when the SPA and API are served from different hosts).
map "" $csp {
    default "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ${NGINX_CSP_CONNECT_SRC}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
}

server {
    listen 8081;
    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"frontend"}';
    }

    # Content-hashed build output: cache for a year. No "always": a 404 must not be cached.
    location /assets/ {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: unknown paths serve index.html, which is never cached so a new release is picked up.
    location / {
        include /etc/nginx/snippets/headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
