# Copy to .env for docker compose. Local development values only; never reuse these anywhere shared.

# MongoDB root user
MONGO_ROOT_USERNAME=fraudguard
MONGO_ROOT_PASSWORD=change-me

# RabbitMQ default user (management UI at http://localhost:15672)
RABBITMQ_DEFAULT_USER=fraudguard
RABBITMQ_DEFAULT_PASS=change-me

# Host ports (change these if another local project already uses the defaults)
MONGO_HOST_PORT=27017
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
