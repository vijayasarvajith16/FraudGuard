# Copy to .env for docker compose. Local development values only; never reuse these anywhere shared.

# MongoDB root user
MONGO_ROOT_USERNAME=fraudguard
MONGO_ROOT_PASSWORD=change-me

# RabbitMQ default user (management UI at http://localhost:15672)
RABBITMQ_DEFAULT_USER=fraudguard
RABBITMQ_DEFAULT_PASS=change-me

# Host ports (change these if another local project already uses the defaults)
MONGO_HOST_PORT=27017
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
AUTH_HOST_PORT=3001
TRANSACTION_HOST_PORT=3002
ALERTING_HOST_PORT=3003
GATEWAY_HOST_PORT=8080

# Per-service MongoDB users (created on first volume init; add new ones to a running stack with `make mongo-users`)
MONGO_AUTH_PASSWORD=change-me
MONGO_TRANSACTIONS_PASSWORD=change-me
MONGO_ALERTS_PASSWORD=change-me

# Shared secrets, each at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
# Keys OTP code derivation and hashing in alerting-service
OTP_SECRET=
# Token lifetime for the demo stack (contract default is 15m)
JWT_EXPIRES_IN=2h

# Admin account bootstrapped by auth-service (password at least 12 characters)
ADMIN_EMAIL=admin@fraudguard.local
ADMIN_PASSWORD=

# MLflow registry the scan services load models from (docs/contracts.md §4.1).
# DagsHub allows anonymous reads of public repos; for a private repo also set
# MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD (a DagsHub token).
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
QUICK_SCAN_HOST_PORT=8001
DEEP_SCAN_HOST_PORT=8002
