        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "quick-scan: scales on CPU (target 60% of the 250m request, 1 to 4 pods)",
      "id": 5,
      "collapsed": false,
