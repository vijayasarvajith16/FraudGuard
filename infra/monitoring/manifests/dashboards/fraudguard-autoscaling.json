    {
      "type": "timeseries",
      "title": "quick-scan replicas",
      "description": "HPA current and desired replicas, and pods actually available.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"fraudguard\", horizontalpodautoscaler=\"quick-scan-service\"}",
          "legendFormat": "current",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"fraudguard\", horizontalpodautoscaler=\"quick-scan-service\"}",
          "legendFormat": "desired",
          "range": true,
          "instant": false
