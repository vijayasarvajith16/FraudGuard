        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"fraudguard\", horizontalpodautoscaler=\"quick-scan-service\"}",
          "legendFormat": "max",
          "range": true,
          "instant": false
