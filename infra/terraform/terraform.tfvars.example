# Copy to terraform.tfvars (gitignored) and fill in. None of these values is a secret: the API key
# stays in ~/.oci/config (profile below). docs/terraform.md walks through where to find each one.

region             = "eu-frankfurt-1" # your home region (Always Free Arm capacity is only there)
oci_config_profile = "DEFAULT"
tenancy_ocid       = "ocid1.tenancy.oc1..aaaaaaaa..."
compartment_ocid   = "ocid1.compartment.oc1..aaaaaaaa..." # or the tenancy OCID for the root compartment

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Your public IP as /32 (e.g. from https://ifconfig.me). SSH and the Kubernetes API accept only these.
admin_cidrs = ["203.0.113.7/32"]

# Optional (defaults shown). Stay within Always Free: A1 total 4 OCPU / 24 GB, block storage 200 GB.
# instance_ocpus            = 2
# instance_memory_gbs       = 12
# boot_volume_gbs           = 100
# availability_domain_index = 0 # try 1 or 2 on "Out of host capacity"
